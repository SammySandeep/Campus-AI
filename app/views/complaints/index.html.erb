<%= page_header "Campus helpdesk", "Report issues and follow every update to resolution." do %><%= link_to "Raise complaint", new_complaint_path, class: "button" if current_user.student? %><% end %><div class="card"><div class="actions" style="margin-bottom:16px"><%= link_to "All", complaints_path, class: "button ghost small" %><% %w[open assigned in_progress resolved closed].each do |status| %><%= link_to status.humanize, complaints_path(status: status), class: "button ghost small" %><% end %></div><div class="table-wrap"><table><thead><tr><th>Ticket</th><th>Category</th><th>Priority</th><th>Reported by</th><th>Status</th><th>Updated</th></tr></thead><tbody><% @complaints.each do |complaint| %><tr><td><strong><%= link_to complaint.title, complaint %></strong><br><small>#<%= complaint.id %></small></td><td><%= complaint.category %></td><td><%= status_badge complaint.priority %></td><td><%= complaint.reported_by.full_name %></td><td><%= status_badge complaint.status %></td><td><%= time_ago_in_words complaint.updated_at %> ago</td></tr><% end %></tbody></table></div></div>

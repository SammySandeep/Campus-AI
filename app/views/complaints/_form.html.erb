<%= form_with model: complaint do |form| %><%= render "shared/errors", object: complaint %><div class="field"><%= form.label :title %><%= form.text_field :title, required: true %></div><div class="field"><%= form.label :description %><%= form.text_area :description, required: true %></div><div class="grid grid-2"><div class="field"><%= form.label :category %><%= form.select :category, %w[IT classroom hostel electrical infrastructure other] %></div><div class="field"><%= form.label :priority %><%= form.select :priority, %w[low medium high urgent] %></div><div class="field"><%= form.label :location %><%= form.text_field :location %></div><% if current_user.admin? %><div class="field"><%= form.label :status %><%= form.select :status, %w[open assigned in_progress resolved closed].map { |s| [s.humanize, s] } %></div><div class="field"><%= form.label :assigned_to_id, "Assign to" %><%= form.collection_select :assigned_to_id, User.where(role: %i[faculty department_admin super_admin]), :id, :full_name, include_blank: true %></div><% end %></div><%= form.submit class: "button" %><% end %>

<%= page_header @complaint.title, "Helpdesk ticket ##{@complaint.id}" do %><div class="actions"><%= status_badge @complaint.status %><%= link_to "Manage", edit_complaint_path(@complaint), class: "button" if current_user.admin? %></div><% end %><div class="grid grid-2"><section class="card"><div class="meta"><span><strong>Category:</strong> <%= @complaint.category %></span><span><strong>Priority:</strong> <%= @complaint.priority.humanize %></span><span><strong>Location:</strong> <%= @complaint.location %></span></div><%= simple_format @complaint.description %><p class="muted">Reported by <%= @complaint.reported_by.full_name %> · Assigned to <%= @complaint.assigned_to&.full_name || "Unassigned" %></p></section><section class="card"><h2>Conversation</h2><ul class="list"><% @complaint.complaint_comments.each do |comment| %><li><strong><%= comment.user.full_name %></strong> <small class="muted"><%= time_ago_in_words(comment.created_at) %> ago</small><br><%= comment.body %></li><% end %></ul><%= form_with model: [@complaint, @comment], url: complaint_comments_path(@complaint) do |form| %><div class="field"><%= form.text_area :body, placeholder: "Add an update…", required: true %></div><%= form.submit "Add comment", class: "button" %><% end %></section></div>

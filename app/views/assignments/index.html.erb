<%= page_header "Assignments", "Track coursework, submissions, grading, and deadlines." do %><%= link_to "New assignment", new_assignment_path, class: "button" if current_user.faculty? || current_user.admin? %><% end %>
<div class="card table-wrap"><table><thead><tr><th>Assignment</th><th>Course</th><th>Due</th><th>Marks</th><th>Status</th></tr></thead><tbody><% @assignments.each do |assignment| %><tr><td><strong><%= link_to assignment.title, assignment %></strong></td><td><%= assignment.course.code %></td><td><%= assignment.due_at.strftime("%d %b, %I:%M %p") %></td><td><%= assignment.maximum_marks %></td><td><%= status_badge(assignment.published? ? "published" : "draft") %></td></tr><% end %></tbody></table></div>

<%= page_header "Search", @query.present? ? "Results for “#{@query}”" : "Search across your authorized campus data." %><% if @results.empty? %><div class="card empty">Enter a term in the campus search bar.</div><% else %><div class="grid grid-2"><% @results.each do |category, records| %><section class="card"><div class="section-title"><h2><%= category %></h2><span class="badge"><%= records.size %></span></div><% if records.any? %><ul class="list"><% records.each do |record| %><li><strong><%= record.try(:title) || record.try(:name) %></strong><br><small class="muted"><%= record.try(:description).to_s.truncate(100) %></small></li><% end %></ul><% else %><div class="empty">No matches</div><% end %></section><% end %></div><% end %>

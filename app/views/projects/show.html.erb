<%= page_header @project.title, @project.academic_year do %><%= status_badge @project.status %><% end %><div class="grid grid-2"><section class="card"><h2>About the project</h2><%= simple_format @project.description %><h3>Team</h3><ul class="list"><% @project.project_memberships.includes(student_profile: :user).each do |membership| %><li class="split"><%= membership.student_profile.user.full_name %><span class="badge"><%= membership.team_role %></span></li><% end %></ul></section><section class="card"><h2>Milestones</h2><ul class="list"><% @project.project_milestones.order(:due_at).each do |milestone| %><li class="split"><span><strong><%= milestone.title %></strong><br><small class="muted">Due <%= milestone.due_at.strftime("%d %b %Y") %></small></span><%= status_badge milestone.status %></li><% end %></ul><h2>Faculty reviews</h2><ul class="list"><% @project.project_reviews.each do |review| %><li><strong><%= review.score %>/100</strong> · <%= review.comments %><br><small class="muted"><%= review.faculty_profile.user.full_name %></small></li><% end %></ul></section></div>

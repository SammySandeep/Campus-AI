<%= page_header "Projects", "Student teams, milestones, submissions, and faculty reviews." %><div class="grid grid-3"><% @projects.each do |project| %><article class="card"><div class="split"><%= status_badge project.status %><span class="muted"><%= project.academic_year %></span></div><h2><%= link_to project.title, project %></h2><p class="muted"><%= truncate project.description, length: 130 %></p><div class="meta"><span><%= project.student_profiles.size %> team members</span><span>Mentor: <%= project.faculty_profile&.user&.full_name || "TBA" %></span></div></article><% end %></div>

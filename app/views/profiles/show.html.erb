<%= page_header "Your profile", "Account and campus identity information." %><div class="card form-card"><div class="split"><span class="avatar"><%= current_user.first_name.first %><%= current_user.last_name.first %></span><%= status_badge current_user.role %></div><h2><%= current_user.full_name %></h2><p><strong>Email:</strong> <%= current_user.email %></p><p><strong>Status:</strong> <%= current_user.active? ? "Active" : "Inactive" %></p><% if @profile %><p><strong>Department:</strong> <%= @profile.department.name %></p><% if current_user.student? %><p><strong>Roll number:</strong> <%= @profile.roll_number %></p><p><strong>Semester:</strong> <%= @profile.semester %></p><p><strong>CGPA:</strong> <%= @profile.cgpa %></p><p><strong>Graduation year:</strong> <%= @profile.graduation_year %></p><% else %><p><strong>Employee ID:</strong> <%= @profile.employee_id %></p><p><strong>Designation:</strong> <%= @profile.designation %></p><% end %><% end %></div>

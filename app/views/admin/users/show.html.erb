<%= page_header "Manage user", @user.email %><div class="card form-card"><%= form_with model: [:admin, @user] do |form| %><%= render "shared/errors", object: @user %><div class="grid grid-2"><div class="field"><%= form.label :first_name %><%= form.text_field :first_name %></div><div class="field"><%= form.label :last_name %><%= form.text_field :last_name %></div></div><% if current_user.super_admin? %><div class="field"><%= form.label :role %><%= form.select :role, User.roles.keys.map { |role| [role.humanize, role] } %></div><% end %><div class="field checkbox"><%= form.label :active do %><%= form.check_box :active %> Active account<% end %></div><%= form.submit "Update user", class: "button" %><% end %></div>

<%= page_header "User management", "Review active accounts and roles. Only super admins can change roles." %><div class="card table-wrap"><table><thead><tr><th>User</th><th>Role</th><th>Department</th><th>Status</th><th>Last login</th></tr></thead><tbody><% @users.each do |user| %><tr><td><strong><%= link_to user.full_name, admin_user_path(user) %></strong><br><small><%= user.email %></small></td><td><%= status_badge user.role %></td><td><%= user.department&.code || "—" %></td><td><%= user.active? ? "Active" : "Disabled" %></td><td><%= user.last_login_at&.strftime("%d %b %Y") || "Never" %></td></tr><% end %></tbody></table></div>

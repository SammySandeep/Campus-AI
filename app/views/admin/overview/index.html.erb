<%= page_header "Administration", "Department and campus-wide operational overview." %><div class="grid stat-grid"><% @stats.each do |label, value| %><div class="card stat"><span class="label"><%= label %></span><strong class="value"><%= value %></strong></div><% end %></div><div class="grid grid-2"><section class="card"><h2>Complaint status</h2><% @complaint_counts.each do |status, count| %><div class="split" style="margin:12px 0"><%= status_badge status %><strong><%= count %></strong></div><% end %></section><section class="card"><h2>Recent campus activity</h2><ul class="list"><% @activities.each do |activity| %><li><%= activity.description %><br><small class="muted"><%= time_ago_in_words activity.created_at %> ago</small></li><% end %></ul></section></div>

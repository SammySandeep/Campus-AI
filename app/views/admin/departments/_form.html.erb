<%= form_with model: [:admin, department] do |form| %><%= render "shared/errors", object: department %><div class="grid grid-2"><div class="field"><%= form.label :name %><%= form.text_field :name %></div><div class="field"><%= form.label :code %><%= form.text_field :code %></div></div><div class="field"><%= form.label :description %><%= form.text_area :description %></div><%= form.submit class: "button" %><% end %>

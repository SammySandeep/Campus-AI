<%= page_header "Departments", "Manage academic departments and see their scale." do %><%= link_to "New department", new_admin_department_path, class: "button" %><% end %><div class="grid grid-3"><% @departments.each do |department| %><article class="card"><div class="split"><span class="badge"><%= department.code %></span><%= link_to "Edit", edit_admin_department_path(department) %></div><h2><%= department.name %></h2><p class="muted"><%= department.description %></p><div class="meta"><span><%= department.student_profiles.size %> students</span><span><%= department.faculty_profiles.size %> faculty</span><span><%= department.courses.size %> courses</span></div></article><% end %></div>

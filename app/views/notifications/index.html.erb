<%= page_header "Notifications", "Updates that need your attention." do %><%= button_to "Mark all read", mark_all_read_notifications_path, method: :patch, class: "button ghost" %><% end %><div class="card"><ul class="list"><% @notifications.each do |notification| %><li class="split"><span><strong><%= notification.title %></strong> <%= content_tag(:span, "New", class: "badge") unless notification.read? %><br><span><%= notification.body %></span><br><small class="muted"><%= time_ago_in_words notification.created_at %> ago</small></span><% unless notification.read? %><%= button_to "Mark read", notification_path(notification), method: :patch, class: "button ghost small" %><% end %></li><% end %></ul></div>

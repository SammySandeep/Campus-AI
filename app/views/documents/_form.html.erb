<%= form_with model: document do |form| %><%= render "shared/errors", object: document %><div class="field"><%= form.label :title %><%= form.text_field :title %></div><div class="grid grid-2"><div class="field"><%= form.label :category %><%= form.text_field :category %></div><div class="field"><%= form.label :visibility %><%= form.select :visibility, %w[everyone students faculty admins].map { |v| [v.humanize, v] } %></div></div><div class="field"><%= form.label :description %><%= form.text_area :description %></div><div class="field"><%= form.label :file %><%= form.file_field :file %></div><%= form.submit "Publish document", class: "button" %><% end %>

<%= page_header "Documents", "Policies, forms, academic resources, and campus notices." do %><%= link_to "Upload document", new_document_path, class: "button" if current_user.admin? %><% end %><%= form_with url: documents_path, method: :get, class: "card", style: "margin-bottom:18px" do |form| %><div class="actions"><%= form.search_field :q, value: params[:q], placeholder: "Search documents…", style: "flex:1;padding:10px;border:1px solid #ddd;border-radius:10px" %><%= form.submit "Search", class: "button" %></div><% end %><div class="grid grid-3"><% @documents.each do |document| %><article class="card"><div class="split"><span class="badge"><%= document.category %></span><small class="muted"><%= document.visibility.humanize %></small></div><h2><%= document.title %></h2><p class="muted"><%= document.description %></p><% if document.file.attached? %><%= link_to "Download file", rails_blob_path(document.file, disposition: "attachment"), class: "button ghost small" %><% else %><span class="muted">Metadata-only demo document</span><% end %></article><% end %></div>

<%= page_header "Campus events", "Discover workshops, festivals, clubs, and student opportunities." %><div class="grid grid-3"><% @events.each do |event| %><article class="card"><div class="split"><span class="badge"><%= event.starts_at.strftime("%d %b") %></span><span class="muted"><%= event.available_seats %> seats left</span></div><h2><%= link_to event.title, event %></h2><p class="muted"><%= truncate event.description, length: 120 %></p><div class="meta"><span>📍 <%= event.location %></span><span>◷ <%= event.starts_at.strftime("%I:%M %p") %></span></div></article><% end %></div>

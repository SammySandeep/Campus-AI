<%= page_header @event.title, "#{@event.starts_at.strftime('%d %B %Y, %I:%M %p')} · #{@event.location}" do %><%= status_badge @event.status %><% end %><div class="grid grid-2"><section class="card"><%= simple_format @event.description %><p><strong>Registration deadline:</strong> <%= @event.registration_deadline.strftime("%d %b, %I:%M %p") %></p><p><strong>Available seats:</strong> <%= @event.available_seats %> / <%= @event.capacity %></p><div class="progress"><span style="width:<%= @event.event_registrations.where(status: 'registered').count * 100 / @event.capacity %>%"></span></div><% if current_user.student? %><div class="actions" style="margin-top:20px"><% if @registration %><%= button_to "Cancel registration", event_registration_path(@event), method: :delete, class: "button danger" %><% else %><%= button_to "Register now", event_registration_path(@event), method: :post, class: "button", disabled: @event.available_seats.zero? %><% end %></div><% end %></section><section class="card"><h2>Registered students</h2><ul class="list"><% @event.event_registrations.where(status: "registered").limit(15).each do |registration| %><li><%= registration.student_profile.user.full_name %></li><% end %></ul></section></div>

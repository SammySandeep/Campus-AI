<%= page_header "Placement opportunities", "Eligibility is calculated from your profile and each company's criteria." %><div class="grid grid-3"><% @placement_drives.each do |drive| %><article class="card"><div class="split"><span class="badge"><%= drive.company.name %></span><% if current_user.student? %><%= status_badge(@eligibility[drive].eligible ? "eligible" : "ineligible") %><% end %></div><h2><%= link_to drive.title, drive %></h2><p class="muted">Drive on <%= drive.drive_date.strftime("%d %b %Y") %></p><div class="meta"><span>CGPA ≥ <%= drive.minimum_cgpa %></span><span>Backlogs ≤ <%= drive.maximum_backlogs %></span></div></article><% end %></div>

<%= page_header @placement_drive.title, @placement_drive.company.name do %><%= status_badge @placement_drive.status %><% end %><div class="grid grid-2"><section class="card"><%= simple_format @placement_drive.description %><p><strong>Drive:</strong> <%= @placement_drive.drive_date.strftime("%d %B %Y") %></p><p><strong>Apply by:</strong> <%= @placement_drive.registration_deadline.strftime("%d %B %Y, %I:%M %p") %></p><p><strong>Departments:</strong> <%= @placement_drive.departments.map(&:code).join(", ") %></p></section><% if current_user.student? %><section class="card"><h2>Eligibility explanation</h2><ul class="list"><% @eligibility.reasons.each do |reason| %><li><span style="color:<%= reason[:passed] ? '#087a61' : '#b42330' %>"><%= reason[:passed] ? '✓' : '✕' %></span> <%= reason[:message] %></li><% end %></ul><div class="actions" style="margin-top:18px"><% if @application && @application.status != "withdrawn" %><%= status_badge @application.status %><%= button_to "Withdraw", placement_drive_application_path(@placement_drive), method: :delete, class: "button danger" %><% elsif @eligibility.eligible %><%= button_to "Apply now", placement_drive_application_path(@placement_drive), method: :post, class: "button" %><% else %><button class="button" disabled>Not eligible</button><% end %></div></section><% end %></div>

<%= page_header "#{@class_session.course.code} attendance", "#{@class_session.session_date.strftime('%d %b %Y')} · #{@class_session.room}" do %><div class="actions"><% if @class_session.status != "open" %><%= button_to "Open attendance", open_attendance_class_session_path(@class_session), method: :patch, class: "button" %><% else %><%= button_to "Close attendance", close_attendance_class_session_path(@class_session), method: :patch, class: "button danger" %><% end %></div><% end %>
<div class="grid grid-2"><section class="card"><div class="section-title"><h2>Live attendance</h2><%= status_badge @class_session.status %></div><strong style="font-size:42px"><%= @class_session.present_count %> / <%= @class_session.enrolled_count %></strong><div class="progress"><span style="width:<%= @class_session.enrolled_count.zero? ? 0 : @class_session.present_count * 100 / @class_session.enrolled_count %>%"></span></div><% if @class_session.attendance_open? %><p><strong>Student attendance link</strong></p><p style="word-break:break-all"><%= link_to attendance_url(@class_session.attendance_token), attendance_url(@class_session.attendance_token) %></p><small class="muted">Expires <%= @class_session.attendance_expires_at.strftime("%I:%M %p") %>. This unique URL is QR-compatible and can be encoded by any campus QR display.</small><% end %></section><section class="card"><div class="section-title"><h2>Present students</h2></div><ul class="list"><% @class_session.attendances.each do |attendance| %><li class="split"><%= attendance.student_profile.user.full_name %><%= status_badge attendance.status %></li><% end %></ul></section></div>

<%= form_with model: class_session do |form| %><%= render "shared/errors", object: class_session %><% courses = current_user.faculty? ? current_user.faculty_profile.courses : Course.all %><div class="field"><%= form.label :course_id %><%= form.collection_select :course_id, courses, :id, ->(c) { "#{c.code} — #{c.name}" }, prompt: "Select course" %></div><div class="grid grid-2"><div class="field"><%= form.label :session_date %><%= form.date_field :session_date %></div><div class="field"><%= form.label :room %><%= form.text_field :room %></div><div class="field"><%= form.label :starts_at %><%= form.time_field :starts_at %></div><div class="field"><%= form.label :ends_at %><%= form.time_field :ends_at %></div></div><%= form.submit "Create session", class: "button" %><% end %>

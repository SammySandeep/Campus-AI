<%= page_header "Attendance", "Secure, time-limited class attendance sessions." do %><%= link_to "New class session", new_class_session_path, class: "button" if current_user.faculty? || current_user.admin? %><% end %>
<div class="card table-wrap"><table><thead><tr><th>Course</th><th>Date & time</th><th>Room</th><th>Attendance</th><th>Status</th></tr></thead><tbody><% @class_sessions.each do |session| %><tr><td><strong><%= link_to session.course.code, session %></strong><br><small><%= session.course.name %></small></td><td><%= session.session_date.strftime("%d %b %Y") %><br><small class="muted"><%= session.starts_at.strftime("%I:%M %p") %></small></td><td><%= session.room %></td><td><%= session.present_count %> / <%= session.enrolled_count %></td><td><%= status_badge session.status %></td></tr><% end %></tbody></table></div>

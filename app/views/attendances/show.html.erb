<%= page_header "Mark attendance", "#{@class_session.course.code} · #{@class_session.course.name}" %><div class="card form-card"><p><strong>Date:</strong> <%= @class_session.session_date.strftime("%d %B %Y") %></p><p><strong>Room:</strong> <%= @class_session.room %></p><p><strong>Window:</strong> <%= status_badge(@class_session.attendance_open? ? "open" : "closed") %></p><% if @already_marked %><div class="flash">Your attendance is already recorded.</div><% elsif @class_session.attendance_open? %><%= button_to "Confirm attendance", attendance_path(params[:token]), method: :post, class: "button" %><% else %><div class="flash alert">This attendance link is closed or expired.</div><% end %></div>
